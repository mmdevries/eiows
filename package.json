{
  "name": "eiows",
  "version": "10.0.0",
  "description": "high-performance Node.js WebSocket engine for Socket.IO",
  "license": "MIT",
  "main": "./dist/eiows.js",
  "types": "./dist/eiows.d.ts",
  "os": ["!win32", "linux", "freebsd", "darwin"],
  "exports": {
    ".": {
      "import": "./dist/wrapper.mjs",
      "require": "./dist/eiows.js",
      "types": "./dist/eiows.d.ts"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "binding.gyp",
    "dist/eiows.js",
    "dist/eiows.d.ts",
    "dist/wrapper.mjs",
    "nodejs/LICENSE",
    "nodejs/src/addon.cpp",
    "uWebSockets/LICENSE",
    "uWebSockets/src/Extensions.cpp",
    "uWebSockets/src/Extensions.h",
    "uWebSockets/src/StreamWebSocket.cpp",
    "uWebSockets/src/StreamWebSocket.h",
    "uWebSockets/src/WebSocketProtocol.h"
  ],
  "scripts": {
    "build": "node-gyp rebuild",
    "install": "node-gyp rebuild > build_log.txt 2>&1",
    "test": "node --test test/*.test.js"
  },
  "engines": {
    "node": ">=16"
  },
  "keywords": [
    "websocket",
    "engine.io",
    "socket.io",
    "eiows"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mmdevries/eiows.git"
  },
  "bugs": {
    "url": "https://github.com/mmdevries/eiows/issues"
  },
  "homepage": "https://github.com/mmdevries/eiows",
  "gypfile": true
}

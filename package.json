{
  "name": "eiows",
  "version": "11.1.0",
  "description": "high-performance Node.js WebSocket engine for Socket.IO",
  "license": "MIT",
  "main": "./dist/eiows.js",
  "types": "./dist/eiows.d.ts",
  "os": [
    "!win32",
    "linux",
    "freebsd",
    "darwin"
  ],
  "exports": {
    ".": {
      "types": "./dist/eiows.d.ts",
      "import": "./dist/wrapper.mjs",
      "require": "./dist/eiows.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "binding.gyp",
    "dist/eiows.js",
    "dist/eiows.d.ts",
    "dist/wrapper.mjs",
    "scripts/build.js",
    "nodejs/LICENSE",
    "nodejs/src/addon.cpp",
    "nodejs/src/native_transport.cpp",
    "nodejs/src/native_transport.h",
    "uWebSockets/LICENSE",
    "uWebSockets/src/Extensions.cpp",
    "uWebSockets/src/Extensions.h",
    "uWebSockets/src/StreamWebSocket.cpp",
    "uWebSockets/src/StreamWebSocket.h",
    "uWebSockets/src/WebSocketProtocol.h"
  ],
  "scripts": {
    "build": "node scripts/build.js",
    "install": "node scripts/build.js",
    "pretest": "npm run test:types",
    "test:types": "tsc -p test/types/tsconfig.json",
    "test": "node --test test/*.test.js",
    "test:fuzz": "node scripts/fuzz-websocket-parser.js"
  },
  "engines": {
    "node": "^22.9.0 || ^24.0.0 || ^26.0.0"
  },
  "keywords": [
    "websocket",
    "engine.io",
    "socket.io",
    "eiows"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mmdevries/eiows.git"
  },
  "bugs": {
    "url": "https://github.com/mmdevries/eiows/issues"
  },
  "homepage": "https://github.com/mmdevries/eiows",
  "gypfile": true,
  "dependencies": {
    "node-gyp": "^12.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "engine.io": "6.6.9",
    "typescript": "^5.9.3"
  }
}
